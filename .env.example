# ── Gmail ────────────────────────────────────────────────────────────────────
# 1. Enable 2-Factor Auth on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Generate an App Password for "Mail"
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# ── Groq ─────────────────────────────────────────────────────────────────────
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── Slack ─────────────────────────────────────────────────────────────────────
# 1. Go to https://api.slack.com/apps → Create New App → From scratch
# 2. Enable "Incoming Webhooks" → Add New Webhook to Workspace
# 3. Copy the webhook URL below (free, no paid plan needed)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ── Discord ──────────────────────────────────────────────────────────────────
# 1. Open Discord → Channel Settings → Integrations → Webhooks → New Webhook
# 2. Copy the webhook URL below (completely free)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# ── Notion ───────────────────────────────────────────────────────────────────
# 1. Go to https://www.notion.so/my-integrations → New integration
# 2. Give it a name and select your workspace
# 3. Copy the "Internal Integration Token" below
# 4. Share any Notion page with your integration (open page → ... → Add connections)
NOTION_TOKEN=secret_your_notion_integration_token_here
